# Local/server secrets only. Copy to .env; never commit real values.
LOG_LEVEL=INFO
# Content-free lifecycle/worker events; never includes prompts, names, bodies or credentials.
FEATURE_LOGS_ENABLED=true
ADMIN_API_TOKEN=
DATABASE_ENGINE=
SQLITE_DB_PATH=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Existing Switch agent credentials. Use the bridge base URL, not the Gateway URL.
SWITCH_BRIDGE_URL=
SWITCH_AGENT_ID=
SWITCH_AGENT_API_KEY=

# One-time registration only; setup never overwrites the existing AI agent.
SWITCH_REGISTRATION_TOKEN=
# Generated once by python -m app.switch_setup; keep real values only in .env.
SWITCH_REQUESTER_AGENT_ID=
SWITCH_REQUESTER_API_KEY=
SWITCH_AI_ROOM_ID=
SWITCH_AI_AGENT_NAME=codex-discord
SWITCH_AI_SENDER_ID=
SWITCH_AI_TIMEOUT_SECONDS=180
# Post AI replies back to the origin Switch room so they relay across the bridge to Discord
SWITCH_REPLY_TO_DISCORD=true

# Dedicated private listener-to-FastAPI credential, generated locally.
SWITCH_INGEST_TOKEN=
# Tagged capture uses normal ingest auth/addressed metadata and needs no user setup.
# Optional confirmed IANA timezone for configured rooms; blank leaves relative dates unresolved.
COMMITMENT_TIMEZONE=
# Separate adapter-only secret for advanced lifecycle actions only; never shared with viewer.
# Set only when using advanced actions after their approved deployment/room policy.
# Simple capture supports Switch addressing with names, aliases and native mentions.
# Advanced actions retain their own sender/authority rules; simple creation does not use them.
SWITCH_ADAPTER_TOKEN=
AUTOMATIC_COMMITMENTS_ENABLED=false
# Local opt-in only after approved schema/policy deployment. Delivery is independently gated.
REMINDERS_ENABLED=false
REMINDER_DELIVERY_ENABLED=false
# One tenant UUID and a comma-separated allow-list of that tenant's Switch room IDs.
SWITCH_TENANT_ID=
SWITCH_ROOM_IDS=
# Optional exact Switch participant IDs of responding AI agents, comma-separated.
# These are sender IDs from Switch, not agent names or SWITCH_AGENT_ID.
SWITCH_AI_SENDER_IDS=
SWITCH_BACKEND_URL=http://127.0.0.1:8000

# Local debugging only: print redacted incoming text in the FastAPI terminal.
LOG_DISCORD_MESSAGES=false

# Local CPU embeddings; install requirements-embeddings.txt and run app.embedding_setup.
# Disabling uses explicitly labelled keyword retrieval; useful text still persists.
LOCAL_EMBEDDINGS_ENABLED=true

# Optional first-person, source-backed profiles. Apply the additive profile
# migration before enabling Supabase storage. HTTP reads need verified user auth.
PERSON_PROFILES_ENABLED=false

# Storage retention timeline and SQLite maximum space quota
STORAGE_RETENTION_VALUE=90
STORAGE_RETENTION_UNIT=days
SQLITE_MAX_SPACE_ENABLED=false
SQLITE_MAX_SPACE_VALUE=500
SQLITE_MAX_SPACE_UNIT=MB


# Restricted admin document routes/worker. Enable only after the additive migration is approved and installed.
DOCUMENT_INGESTION_ENABLED=false

# Optional Switch/Discord attachment consent. Separate listener-only token; never give it to the viewer/mobile.
# Enable only after bridge/bot setup and verified per-person origin support.
# Required adapter metadata: sender_kind=user. Checked Switch contract lacks this; keep disabled.
SWITCH_DOCUMENT_ATTACHMENTS_ENABLED=false
SWITCH_DOCUMENT_ADAPTER_TOKEN=
# No uploader registration or personal allowlist. Unsupported/unverified origins fail closed.
# Exact Switch IDs of the trusted Discord bridge(s), not Discord guild/channel IDs.
SWITCH_DOCUMENT_DISCORD_BRIDGE_IDS=
# Exact participant/sender ID of the non-AI posting client (not its agent UUID); suppresses reply echoes.
SWITCH_DOCUMENT_BOT_SENDER_ID=
SWITCH_DOCUMENT_CONFIRMATION_SECONDS=900
SWITCH_DOCUMENT_MAX_FILES=4
SWITCH_DOCUMENT_MAX_BYTES=262144
SWITCH_DOCUMENT_MAX_TEXT_CHARS=262144
SWITCH_DOCUMENT_DOWNLOAD_SECONDS=20
SWITCH_DOCUMENT_PROCESSING_SECONDS=900
SWITCH_DOCUMENT_MAX_PENDING=200
SWITCH_DOCUMENT_MAX_RECORDS=10000
